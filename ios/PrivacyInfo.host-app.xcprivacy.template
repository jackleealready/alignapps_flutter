<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Optional host app privacy manifest.

      AlignApps declares its own tracking domain in the SDK's bundled manifest
      (alignapps_flutter_privacy.bundle), injected at build time from
      ios/Flutter/AlignappsPrivacyDomain.txt. You do NOT need this file for
      AlignApps itself.

      Use this file only if your own app code (not AlignApps) also tracks users.
      Put it in your iOS app target, e.g. ios/Runner/PrivacyInfo.xcprivacy, add
      it to "Copy Bundle Resources", and replace the placeholder with your own
      tracking host. Never list your business API domain here.
    -->
    <key>NSPrivacyTracking</key>
    <true/>
    <key>NSPrivacyTrackingDomains</key>
    <array>
        <string>__ALIGNAPPS_TRACKING_DOMAIN__</string>
    </array>
</dict>
</plist>
